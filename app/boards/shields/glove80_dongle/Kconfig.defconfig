if SHIELD_GLOVE80_DONGLE

config ZMK_KEYBOARD_NAME
    default "Glove80"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# The dongle has two peripherals: the Glove80 left and right halves.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Peripherals (2) + desired number of host Bluetooth profiles (5, matching
# the stock Glove80 central).
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

config ZMK_USB
    default y

config ZMK_BLE
    default y

# Fetch peripheral battery levels so they can be reported to the host.
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y

# Expose each peripheral's battery level to the host as its own auxiliary
# Battery Service instance, so BLE-side battery-monitoring tools (e.g.
# zmk-battery-center) can see LH and RH separately, not just whatever the
# dongle itself reports.
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    default y

# The dongle has no LED strip of its own, but &rgb_ug is a
# BEHAVIOR_LOCALITY_GLOBAL behavior: zmk_behavior_invoke_binding() resolves
# the behavior device *locally* on the central before it will relay the
# command to peripherals at all (see src/behavior.c). Without RGB_UNDERGLOW
# enabled here, that local lookup fails and the command is silently dropped
# before ever reaching LH/RH - so this needs to stay on even though the
# dongle itself has nothing to light up. See the small placeholder
# led_strip in glove80_dongle.overlay this depends on.
config ZMK_RGB_UNDERGLOW
    default y

if ZMK_RGB_UNDERGLOW

config SPI
    default y

config WS2812_STRIP
    default y

endif # ZMK_RGB_UNDERGLOW

endif # SHIELD_GLOVE80_DONGLE
