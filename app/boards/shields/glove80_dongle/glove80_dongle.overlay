#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include "../../arm/glove80/glove80-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &physical_layout0;
        /*
         * The dongle has no LED strip of its own, but &rgb_ug is a
         * BEHAVIOR_LOCALITY_GLOBAL behavior - the central must be able to
         * resolve the behavior device locally (see src/behavior.c) before
         * it will relay RGB commands on to LH/RH at all. This placeholder
         * satisfies that requirement; see the single-pixel led_strip below.
         */
        zmk,underglow = &led_strip;
        /*
         * The generic XIAO BLE board overlay sets zmk,battery to &vbatt,
         * assuming a LiPo is attached. A bare dongle typically has none, so
         * that ADC reading would be meaningless noise. Drop the chosen
         * property entirely (rather than just disabling &vbatt below) so
         * src/battery.c takes its "no battery chosen" code path instead of
         * trying to reference the now-disabled device - referencing a
         * disabled node via DEVICE_DT_GET(DT_CHOSEN(...)) is a compile
         * error, not a graceful runtime no-op.
         */
        /delete-property/ zmk,battery;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    /*
     * Placeholder ext_power device. src/rgb_underglow.c reads this
     * unconditionally (not gated by CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER) in
     * its critical-battery auto-off path, so simply disabling that Kconfig
     * option isn't enough - the zmk,ext-power-generic instance needs to
     * actually exist. Found via DT_INST(0, zmk_ext_power_generic), which
     * doesn't need a chosen property, just one enabled node anywhere in the
     * tree. control-gpios points at an unused XIAO pin - the dongle has no
     * keys/buttons claiming any pins, and this is never expected to be
     * physically connected to anything.
     */
    EXT_POWER: ext_power {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&xiao_d 0 GPIO_ACTIVE_HIGH>;
    };

    /*
     * Copied from boards/arm/glove80/glove80.dtsi. The dongle has no keys of
     * its own, but needs the same matrix transform as the real halves so
     * that key position events reported by the LH/RH peripherals map to the
     * correct behaviors. Keep this in sync if the Glove80 matrix ever
     * changes.
     */
    matrix_transform0: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <6>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)                                                                    RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                                                    RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                                                    RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                                                    RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(0,6) RC(1,6) RC(2,6)   RC(2,7) RC(1,7)  RC(0,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4)         RC(3,6) RC(4,6) RC(5,6)   RC(5,7) RC(4,7)  RC(3,7)         RC(5,9) RC(5,10) RC(5,11) RC(5,12) RC(5,13)
        >;
    };
};

&physical_layout0 {
    transform = <&matrix_transform0>;
};

/*
 * Single-pixel placeholder WS2812 strip. Not expected to be physically
 * connected to anything - this exists purely so the &rgb_ug behavior device
 * exists locally on the dongle (see the zmk,underglow chosen comment above).
 * &xiao_spi is the Seeed XIAO interconnect's portable SPI bus label.
 */
&xiao_spi {
    status = "okay";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;

        chain-length = <1>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

/*
 * Now that nothing references &vbatt via the zmk,battery chosen property
 * (deleted above), it's safe to disable the underlying voltage-divider
 * device too, so its ADC/GPIO driver isn't even compiled in or initialized.
 */
&vbatt {
    status = "disabled";
};
